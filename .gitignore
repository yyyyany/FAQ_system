# ==========================================================
# 集成问答系统 .gitignore
# 原则: 源码/文档/小语料入库; 密钥/模型权重/日志/缓存不入库
# ==========================================================

# ---------- 1. 密钥与本地配置(禁止入库) ----------
config.ini
config.local.ini
*.local.ini
.env
.env.*
!.env.example
!config.example.ini

# ---------- 2. 模型权重(约 6.3GB, 按 rag_qa/models/README.md 自行下载) ----------
# 注意: 用 models/* 而不是 models/, 否则下方 ! 例外规则会失效
rag_qa/models/*
!rag_qa/models/README.md

# ---------- 3. 向量库/索引/中间产物 ----------
chroma_db/
chroma/
vector_store/
milvus_data/
*.faiss
*.index
*.docstore.json
*.embeddings.json
rag_qa/data/processed/
rag_qa/data/chunks/
rag_qa/data/dist/

# ---------- 4. 日志 ----------
logs/*
!logs/.gitkeep
*.log
*.log.*

# ---------- 5. Python 缓存与构建 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
develop-eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
wheels/
pip-wheel-metadata/
.venv/
venv/
env/
ENV/
.python-version

# ---------- 6. 测试/检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ---------- 7. PyCharm/JetBrains(dataSources.xml 含数据库密码) ----------
.idea/
*.iml
*.ipr
*.iws
.out/
.fleet/

# ---------- 8. Notebook ----------
.ipynb_checkpoints/

# ---------- 9. 前端/Node(当前无构建, 防御性保留) ----------
node_modules/
.vite/

# ---------- 10. 操作系统/临时文件 ----------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.swp
*~
.~lock.*
temp/
tmp/
