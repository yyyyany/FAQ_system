# 统一换行符: 仓库内一律 LF, Windows 脚本保留 CRLF
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.ini   text eol=lf
*.json  text eol=lf
*.jsx   text eol=lf
*.html  text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf

*.bat   text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行符转换
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.jpg   binary
*.png   binary
*.bin   binary
*.pt    binary
*.h5    binary
*.msgpack binary
*.safetensors binary
